# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# Optional: multiple database aliases as JSON
# Example: {"default":"postgres://user:password@localhost:5432/mydb","analytics":"postgres://user:password@localhost:5432/analytics"}
DATABASE_URLS=

# Optional: default database alias when DATABASE_URLS is used (default: default)
DEFAULT_DATABASE=default

# Query timeout in milliseconds (default: 5000)
STATEMENT_TIMEOUT_MS=5000

# Maximum rows returned per query (default: 500)
MAX_ROWS=500

# Maximum semicolon-separated statements per multi-statement tool call (default: 10)
MAX_STATEMENTS=10

# Write JSON audit events to stderr (default: false)
AUDIT_LOG=false
